# Build context MUST be the repo root (npm workspaces resolve @benzenejs/* packages from src/* via
# symlinks the root install creates - this example's package.json depends on them by workspace version,
# not a published npm version). One image, deployed three times as orders/payments/shipping — MESH_SERVICE
# picks the domain at startup (see src/index.ts).
#   docker build -f examples/k8s-mesh/Dockerfile.service -t benzene-k8smesh-service:local .
FROM node:22-alpine
WORKDIR /app

COPY package.json package-lock.json ./
COPY src ./src
COPY examples/k8s-mesh ./examples/k8s-mesh
RUN npm install

ENV PORT=8080
EXPOSE 8080
CMD ["npx", "tsx", "examples/k8s-mesh/src/index.ts"]
